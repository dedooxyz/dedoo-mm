[Unit]
Description=Dedoo Multisig Manager keeper node
Documentation=https://github.com/dedooxyz/dedoo-mm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dedoo
Group=dedoo
WorkingDirectory=/opt/dedoo-mm
EnvironmentFile=/opt/dedoo-mm/dedoo-mm.env
ExecStart=/opt/dedoo-mm/dedoo-mm
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dedoo-mm

[Install]
WantedBy=multi-user.target
