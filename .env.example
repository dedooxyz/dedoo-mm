# ==============================================================================
# Dedoo Multisig Manager Daemon Configuration (.env)
# Single 2-of-3 (or M-of-3) multisig vault, managed manually by the keeper trio.
# Nothing about the multisig is hardcoded: chain profile, vault address, redeem
# script/pubkeys and threshold all come from this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. CHAIN SELECTION
# ------------------------------------------------------------------------------
# Supported chains (aliases in parentheses):
#   "wojakcoin" (wojak, wjk, mainnet) — P2PKH 73, P2SH 5, WIF 201, maturity 20
#   "junkcoin"  (junk, jkc)           — P2PKH 16, P2SH 5, WIF 144, maturity 70
# All three nodes of a trio MUST use the same CHAIN.
CHAIN="wojakcoin"

# Fully custom chain (fork / other coin): no compiled-in defaults are used.
# Set CHAIN="custom" and provide ALL of these explicitly:
#   CHAIN_NAME="myfork"
#   ADDR_PUBKEY_VERSION="110"   # P2PKH base58 version
#   ADDR_SCRIPT_VERSION="111"   # P2SH base58 version (vault)
#   WIF_VERSION="112"           # WIF private-key version
#   COINBASE_MATURITY="30"      # consensus coinbase maturity
#   ELECTRS_URL="https://esplora.myfork.example"

# ------------------------------------------------------------------------------
# 1. NODE IDENTITY & SIGNING (Required per Keeper Node)
# ------------------------------------------------------------------------------
# Mode: "keeper" (active cosigner) or "bootstrap" (standalone relay)
KEEPER_MODE="keeper"

# Keeper operator index (0, 1, or 2). Each of the 3 nodes MUST have a unique index.
KEEPER_SELF_INDEX="0"

# Operator private WIF key for this node (chain-specific WIF).
# WojakCoin: version 201 (compressed keys start with W).
# Junkcoin:  version 144 (compressed keys start with N).
# May be left empty: the node then starts as a wallet manager and you add
# the wallet + WIF from the UI. Never commit a real WIF to a repository.
KEEPER_WIF="<Operator_Private_WIF_Key_Here>"

# ------------------------------------------------------------------------------
# 2. MULTISIG VAULT (all values are operator-supplied; no built-in defaults)
# ------------------------------------------------------------------------------
# P2SH address of the launch multisig wallet. It must be the P2SH output of
# the redeem script configured below. May be left empty in manager mode.
VAULT_ADDRESS="<Vault_P2SH_Address>"

# Signature threshold encoded in the redeem script (M in M-of-3).
# Default: 2. Must match the redeem script.
REQUIRED_SIGS="2"

# Redeem script source (choose ONE):
#
# OPTION A (recommended): provide the 3 compressed ceremony public keys and
# the key ordering; the daemon derives the M-of-3 redeem script at startup.
CEREMONY_PUBKEYS="<pubkey_operator_0>,<pubkey_operator_1>,<pubkey_operator_2>"
KEY_ORDER="0,1,2"

# OPTION B: provide the exact redeem script hex (overrides Option A).
# REDEEM_SCRIPT_HEX="522102...2103...2102...53ae"

# ------------------------------------------------------------------------------
# 3. CHAIN BACKEND
# ------------------------------------------------------------------------------
# MODE A: 100% Electrs/Esplora REST (default, recommended).
# Leave ELECTRS_URL unset to use the CHAIN default:
#   wojakcoin -> https://wojak-api.s3na.xyz
#   junkcoin  -> https://junk-api.s3na.xyz
# Comma-separate multiple URLs for automatic failover.
BACKEND="electrs"
ELECTRS_URL="https://wojak-api.s3na.xyz"

# MODE B: 100% Core JSON-RPC (no Electrs).
# BACKEND="rpc"
# WJK_RPC_URL="http://127.0.0.1:8332,http://192.168.1.50:8332"
# WJK_RPC_USER="wojakrpc"
# WJK_RPC_PASS="rpcpassword"

# ------------------------------------------------------------------------------
# 4. EXECUTION & TRANSFER POLICY
# ------------------------------------------------------------------------------
# Minimum confirmations for spendable outputs. Defaults to the chain's
# consensus coinbase maturity (WojakCoin 20, Junkcoin 70) and is clamped to it.
COINBASE_MATURITY="20"

# Minimum manual transfer amount in satoshis (dust floor).
MIN_TRANSFER_SATS="10000"

# Maximum number of vault UTXOs bundled into one transaction. This is an
# operator cap; the keeper also enforces the chain's standard transaction size
# (100 KB), which allows about 333 P2SH 2-of-3 inputs per transaction.
MAX_TX_INPUTS="100"

# ------------------------------------------------------------------------------
# 5. SIGNING & BROADCAST POLICY (human-in-the-loop by default)
# ------------------------------------------------------------------------------
AUTO_SIGN="false"
AUTO_BROADCAST="false"

# ------------------------------------------------------------------------------
# 6. P2P NETWORKING
# ------------------------------------------------------------------------------
P2P_BIND="0.0.0.0"
P2P_PORT="4000"
# Stable group name shared by every keeper in this trio. The P2P checksum and
# DHT namespace use CHAIN + P2P_GROUP, so adding wallets does not require a
# restart. Leave empty to fall back to CHAIN.
P2P_GROUP=""
P2P_KEYFILE="keeper-identity.bin"
P2P_PUBLIC_DHT="true"
# P2P_PEERS="/ip4/<node0>/tcp/4000/p2p/<ID0>,/ip4/<node1>/tcp/4000/p2p/<ID1>,/ip4/<node2>/tcp/4000/p2p/<ID2>"
# P2P_BOOTSTRAP=""

# ------------------------------------------------------------------------------
# 7. REST API & PERSISTENCE
# ------------------------------------------------------------------------------
API_LISTEN="127.0.0.1:8080"
# Optional HTTP Basic Auth for the web UI + API (set both or neither).
# Only needed when the UI is reachable without an SSH tunnel; put TLS in
# front (Caddy/Nginx) if exposed beyond localhost.
# API_AUTH_USER="holder"
# API_AUTH_PASS="change-me-long-password"
# Saved multisig wallet metadata (created/removed in the Wallets page).
ACCOUNTS_FILE="keeper-accounts.json"

# Imported signing keys (WIFs added in the UI, 0600). One key can sign every
# wallet whose redeem script contains its public key.
KEYS_FILE="keeper-keys.json"

STATE_FILE="keeper-state.json"
LOG_LEVEL="info"
